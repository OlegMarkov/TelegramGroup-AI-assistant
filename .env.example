# Telegram
BOT_TOKEN=

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# How long to wait for a summary before giving up. Long summaries take ~25s;
# this is the ceiling, not the expected time.
DEEPSEEK_TIMEOUT_MS=120000

# Daily ceiling on DeepSeek completions, across all users, resetting at 00:00
# UTC. Both optional; leave empty for no cap. WARN DMs the ADMIN_USER_IDS once
# a day; MAX stops making calls until midnight or until an admin runs
# "/spend allow <n>". A summary costs roughly RUB 0.10, so 2000/day is about
# RUB 200/day worth of headroom.
DEEPSEEK_DAILY_WARN_COMPLETIONS=
DEEPSEEK_DAILY_MAX_COMPLETIONS=

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SQLite
DATABASE_PATH=./data/bot.db

# App
LOG_LEVEL=info
NODE_ENV=development
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=10

# Comma-separated Telegram user IDs allowed to run /stats
ADMIN_USER_IDS=

# Privacy / data retention
# Stored group messages are deleted after this many days
MESSAGE_RETENTION_DAYS=90
# Grace period before purging a group's messages after the bot is removed from it
PURGE_AFTER_REMOVAL_DAYS=7

# Off-site backups (deploy/offsite-backup.sh, run from deploy/backup.sh)
# An rclone remote and path, e.g. b2:my-bucket/telegram-bot or s3:my-bucket/bot.
# Leave OFFSITE_REMOTE empty to skip the off-site copy entirely.
OFFSITE_REMOTE=
# Passphrase the backup is encrypted with before it leaves the server. The
# database holds other people's message content, so an empty value here is
# refused rather than defaulting to an unencrypted upload.
# KEEP A COPY SOMEWHERE OTHER THAN THIS SERVER: losing it loses the backups.
OFFSITE_PASSPHRASE=
OFFSITE_KEEP_DAILY=7
OFFSITE_KEEP_WEEKLY=4
